API_PORT=3002
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lost_found_hub

# Optional frontend settings.
# Keep blank during Vite dev to use vite.config.js proxy.
VITE_API_BASE_URL=

# Set to true when you want the page to fail visibly if the API is down.
VITE_REQUIRE_API=false

# Password reset OTP.
# For Gmail, create a Google App Password and put it in SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PASSWORD_RESET_OTP_MINUTES=10
PASSWORD_RESET_TOKEN_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# Email notifications for post submission and approval decisions.
NOTIFICATION_EMAIL_ENABLED=true
APP_PUBLIC_URL=http://127.0.0.1:5173
PICKUP_LOCATION=ຫ້ອງຄຸ້ມຄອງ
PICKUP_HOURS=ຈັນ–ສຸກ 08:00–16:00

# Real deployment must keep this false so OTP is sent through Gmail only.
# Change to true only when developing locally without SMTP credentials.
OTP_DEV_MODE=false
